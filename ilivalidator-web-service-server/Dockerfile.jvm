FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24

USER 0
RUN install -d -o 0 -g 0 -m 0770 /work
WORKDIR /opt/app
COPY --chown=0:0 --chmod=0444 target/ilivalidator-web-service-server-*.jar ./application.jar

ENV ILI_CACHE=/tmp/ilicache
VOLUME ["/work"]
USER 1001:0

ENTRYPOINT ["java", "-XX:+UseG1GC", "-XX:InitialRAMPercentage=10", "-XX:MaxRAMPercentage=90.0", "-XX:G1PeriodicGCInterval=30000", "-XX:+ExplicitGCInvokesConcurrent", "-XX:MaxMetaspaceSize=256m", "-Xss256k", "-jar", "/opt/app/application.jar", "--spring.profiles.active=docker"]
